{
  "name": "blue-gold-daily",
  "version": "1.0.0",
  "private": true,
  "description": "True Melange Φ — Blue-Gold Daily. A saffron-hemp ready-to-drink tea. Public site.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jonathan Peoples <Concord, NC>",
  "homepage": "https://bluegolddaily.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeruAhmose/blue-gold-daily.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "serve . -l 4173",
    "serve:dist": "serve dist -l 4173",
    "build": "node scripts/build.mjs",
    "check": "npm run check:html && npm run check:links && npm run check:claims",
    "check:html": "html-validate \"*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "audit:security": "npm audit --audit-level=low",
    "deploy:netlify": "netlify deploy --dir=dist --prod",
    "deploy:vercel": "vercel deploy dist --prod --yes",
    "test": "npm run check"
  },
  "devDependencies": {
    "@lhci/cli": "0.13.0",
    "html-validate": "8.29.0",
    "netlify-cli": "17.38.1",
    "serve": "14.2.6",
    "vercel": "59.1.3",
    "wait-on": "7.2.0"
  },
  "keywords": [
    "trai",
    "true-melange",
    "blue-gold-daily"
  ]
}
